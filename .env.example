# =============================================================================
# Engineering Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pawan@localhost:5432/engineering_intelligence
DATABASE_URL_SYNC=postgresql://pawan@localhost:5432/engineering_intelligence

# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------
# Create a fine-grained PAT at:
#   GitHub → Settings → Developer settings → Personal access tokens
# Required permissions: Pull requests (Read), Contents (Read), Issues (Read), Metadata (Read)
GITHUB_TOKEN=ghp_your_token_here

# Default repository to analyze (owner/repo format)
GITHUB_DEFAULT_REPO=owner/repo-name

# -----------------------------------------------------------------------------
# Ollama (Local LLM)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b-it-q4_K_M

# -----------------------------------------------------------------------------
# Embedding Model
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Collection Settings
# -----------------------------------------------------------------------------
# Maximum PRs to fetch per sync (start small: 10 → 50 → 100 → 500)
MAX_PRS_PER_SYNC=50
# Seconds to wait when rate-limited
RATE_LIMIT_WAIT=60
